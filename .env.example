# Local development defaults only. Copy to .env and keep .env untracked.
# Do not put production credentials, StoreKit keys, or payment secrets here.

ENVIRONMENT=development
LOG_LEVEL=INFO

POSTGRES_DB=virtual_zoo
POSTGRES_USER=virtual_zoo
POSTGRES_PASSWORD=virtual_zoo_local_only
DATABASE_URL=postgresql+asyncpg://virtual_zoo:virtual_zoo_local_only@postgres:5432/virtual_zoo

REDIS_URL=redis://redis:6379/0

STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=/data/assets
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

OPENROUTER_API_KEY=
# HTTP proxy in EU/US when the API host is in RU (same pattern as kid).
OPENROUTER_HTTP_PROXY=
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
OPENROUTER_IMAGE_PROVIDER=
# Vision model that names the creature and picks a kind. Image model stays separate.
OPENROUTER_PROFILE_MODEL=google/gemini-2.5-flash
OPENROUTER_PROFILE_PROVIDER=

# Image-to-3D for the web island only. Empty keeps the 2.5D standee.
MESHY_API_KEY=

# Operator console is SQLAdmin at /staff. Same login unlocks /v1/operator.
OPERATOR_LOGIN=
OPERATOR_PASSWORD=
OPERATOR_TOKEN=
ADMIN_SECRET_KEY=

# T-Bank internet acquiring. Empty disables checkout (catalog still works).
TBANK_TERMINAL_KEY=
TBANK_PASSWORD=
TBANK_API_URL=https://securepay.tinkoff.ru/v2
TBANK_TAXATION=usn_income
TBANK_ITEM_TAX=none
TBANK_COMPANY_EMAIL=
PUBLIC_SITE_URL=https://zooo.fun
